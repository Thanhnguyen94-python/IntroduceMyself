ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# Mật khẩu để khách xuất PDF ở trang /cv (admin đã đăng nhập không cần). Để trống = chỉ admin xuất được.
CV_EXPORT_PASSWORD=

# Email notification (Resend)
