NEXT_PUBLIC_PRIVATE_DOCS_PASSWORD_HASH=1d296d16fe2421bef93f8420cc6e3c99c8acef8029899c894d93c8c0979736a5

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Admin
# BẮT BUỘC trên production: chuỗi ngẫu nhiên >= 32 ký tự. Tạo bằng: npm run secret:generate
ADMIN_SESSION_SECRET=
# Chỉ dùng khi chạy LOCAL mà không có Supabase (production luôn xác thực qua bảng admin_profiles).
# Để trống ADMIN_PASSWORD = không cho đăng nhập local.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# Mật khẩu để khách xuất PDF ở trang /cv (admin đã đăng nhập không cần). Để trống = chỉ admin xuất được.
CV_EXPORT_PASSWORD=

# Địa chỉ web công khai (dùng cho link trong email thông báo). Vd: https://introduce-myself-topaz.vercel.app
NEXT_PUBLIC_SITE_URL=

# Email notification (Resend) - dùng cho đơn hàng, chat và câu hỏi tài liệu
# ADMIN_NOTIFY_EMAIL: nơi nhận thông báo chat/hỏi đáp (để trống = dùng ORDER_NOTIFY_EMAIL_TO)
ADMIN_NOTIFY_EMAIL=
RESEND_API_KEY=
ORDER_NOTIFY_EMAIL_TO=
ORDER_NOTIFY_EMAIL_FROM=onboarding@resend.dev

# Optional webhooks (Make/Zapier/n8n/custom bot)
ORDER_WEBHOOK_URL=
ZALO_WEBHOOK_URL=


MCP_SHARED_SECRET=abc123xyz

# ===== AI (tuỳ chọn) - tóm tắt thảo luận trong báo cáo ngày/tuần của /smt =====
# Để trống = tắt, web chạy bình thường. Sau khi đặt: vào /smt/quan-tri → Lịch báo cáo → bật "Tóm tắt AI".
# AI_PROVIDER: anthropic | openai (openai = mọi dịch vụ tương thích OpenAI: OpenAI, OpenRouter, Groq, Gemini...)
AI_PROVIDER=
AI_API_KEY=
# anthropic bỏ trống = model mặc định; openai bắt buộc ghi tên model của dịch vụ
AI_MODEL=
# Tuỳ chọn: đổi endpoint, vd https://openrouter.ai/api/v1
AI_BASE_URL=

# Tuỳ chọn: chuỗi ngẫu nhiên >= 16 ký tự để dịch vụ cron gọi /api/smt/reports/run (báo cáo đúng giờ
# kể cả khi không ai mở web). Không đặt = báo cáo vẫn được tạo khi có người mở /smt.
CRON_SECRET=
